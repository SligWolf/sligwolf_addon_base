// ------------------------------
//   Base addon: Railway switches
// ------------------------------

@BaseClass base(Targetname, Global, Angles, Studiomodel, SLIGWOLF_BASECLASS_phys_static) = SLIGWOLF_BASECLASS_railway_switch_base
[
	SetBodyGroup(integer) : "Body Group" : 0

	input SetBodyGroup(integer) : "Set the visible bodygroup, by index."
	input Switch(void) : ""
	input Reset(void) : ""
	input SetStateByID(integer) : ""
	input SetStateByName(string) : ""

	output OnSwitch(void) : ""
	output OnReset(void) : ""
	output OnSwitchById(integer) : ""
	output OnSwitchByName(string) : ""
]

@PointClass base(SLIGWOLF_BASECLASS_railway_switch_base) color(85 190 255) studioprop() = sligwolf_railway_switch :
	"SligWolf's Addon: Generic railway switch"
[
]


// ------------------------------
